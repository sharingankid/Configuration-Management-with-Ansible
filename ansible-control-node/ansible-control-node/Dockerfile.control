# Reusable Ansible control node for learning environments.
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

LABEL org.opencontainers.image.title="ansible-control" \
      org.opencontainers.image.description="Pinned Ansible control node for learning environments" \
      org.opencontainers.image.version="1.0.0"

ARG ANSIBLE_CORE_VERSION=2.17.7
ARG ANSIBLE_LINT_VERSION=24.9.2
ARG YAMLLINT_VERSION=1.35.1
ARG USERNAME=ansible
ARG UID=1000
ARG GID=1000

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ANSIBLE_HOME=/home/ansible/.ansible \
    XDG_CACHE_HOME=/home/ansible/.cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       git \
       openssh-client \
       sshpass \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      "ansible-core==${ANSIBLE_CORE_VERSION}" \
      "ansible-lint==${ANSIBLE_LINT_VERSION}" \
      "yamllint==${YAMLLINT_VERSION}" \
    && python -c "from importlib.metadata import version; assert version('ansible-core') == '${ANSIBLE_CORE_VERSION}'; assert version('ansible-lint') == '${ANSIBLE_LINT_VERSION}'; assert version('yamllint') == '${YAMLLINT_VERSION}'" \
    && ansible --version >/dev/null \
    && ansible-lint --version >/dev/null \
    && yamllint --version >/dev/null

# Reuse an existing group when the host GID already exists in the base image.
# This is common on macOS, where the default group is GID 20.
RUN if ! getent group "${GID}" >/dev/null; then groupadd --gid "${GID}" "${USERNAME}"; fi \
    && useradd --uid "${UID}" --gid "${GID}" --create-home --shell /bin/bash "${USERNAME}" \
    && mkdir -p "/home/${USERNAME}/.ssh" "/home/${USERNAME}/.ansible/tmp" "/home/${USERNAME}/.cache" /work \
    && chmod 700 "/home/${USERNAME}/.ssh" \
    && chown -R "${UID}:${GID}" "/home/${USERNAME}" /work

COPY --chown=${UID}:${GID} ssh_config /home/ansible/.ssh/config
RUN chmod 600 /home/ansible/.ssh/config

USER ansible
WORKDIR /work

ENTRYPOINT ["/bin/bash"]
